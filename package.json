{
  "name": "ngx-query-builder",
  "version": "22.0.1",
  "description": "A modernized Angular query builder component — Angular 22, standalone, signals",
  "license": "MIT",
  "private": true,
  "keywords": [
    "angular",
    "angular22",
    "query",
    "builder",
    "querybuilder",
    "visual",
    "standalone",
    "signals"
  ],
  "author": {
    "name": "Argela Inc.",
    "url": "https://argela.com.tr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argela-uxui/ngx-query-builder.git"
  },
  "bugs": {
    "url": "https://github.com/argela-uxui/ngx-query-builder/issues"
  },
  "homepage": "https://github.com/argela-uxui/ngx-query-builder#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-query-builder --configuration production",
    "publish": "npm run build && cd dist/ngx-query-builder && npm publish",
    "build:watch": "ng build ngx-query-builder --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "npm run lint:lib && npm run lint:demo",
    "lint:lib": "ng lint ngx-query-builder",
    "lint:demo": "ng lint demo",
    "clean": "rimraf dist coverage",
    "ci": "npm run lint && npm run test && npm run e2e && npm run build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e/playwright-report"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.2",
    "@angular/build": "22.2.2",
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/schematics": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/cdk": "22.2.1",
    "@angular/cli": "22.2.2",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/language-service": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@playwright/test": "1.59.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.17",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "angular-eslint": "22.5.0",
    "eslint": "9.39.4",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-preset-angular": "17.0.2",
    "ng-packagr": "22.2.4",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "sass": "1.105.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.1",
    "zone.js": "0.16.3"
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "test-exclude": "^8.0.0"
  }
}
